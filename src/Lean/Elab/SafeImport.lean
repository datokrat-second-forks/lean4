/-!
# `safe import`

`safe import M` imports only the kernel declarations of an untrusted module `M`. `M` is never loaded
from an `.olean` file into the importing process, as `.olean` files are not validated on load and a
malicious one can execute arbitrary code. Instead:

1. `M` is elaborated by `lean --safe-export M.lean` inside the sandbox given by the
   `LEAN_SAFE_SANDBOX` environment variable, a whitespace-separated command prefix such as
   `bwrap --ro-bind / / --unshare-all --`. The sandboxed process prints the kernel declarations of
   `M` to stdout in the JSON format described below. The source of `M` is searched for in
   `LEAN_SRC_PATH` and the current directory. Safe imports within `M` are processed without
   further sandboxing.
2. The importing process parses this output with a validating decoder, rebuilding every term via
   the regular `Expr`/`Level`/`Name` constructors (and thus recomputing all cached data), and sends
   each declaration to the kernel. Constructors and recursors are generated by the kernel.
3. The imported definitions are marked `noncomputable`; no compiled code, IR or environment
   extension data of `M` is imported.

The imported declarations become part of the importing module, i.e. they are stored in its `.olean`
file. Two modules that each `safe import` the same module can therefore not be imported together.

The regular imports of `M` must already be (regularly, i.e. trustedly) imported by the importing
module so that their declarations are not taken from the sandboxed process.

## Export format

A single JSON object:
```
{ "version": 1,
  "imports": [name, ...],           -- regular imports of the module
  "names": [entry, ...],            -- index 0: anonymous; entry: [prefix, "s"] or [prefix, n]
  "levels": [entry, ...],           -- index 0: zero; entry: ["succ", l], ["max", l, l],
                                    -- ["imax", l, l] or ["param", name]
  "exprs": [entry, ...],            -- see `exportExpr`
  "decls": [{"kind": ..., ...}, ...] -- in dependency order, see `exportDecl`
}
```
Table entries may only refer to earlier entries of their table.
-/

namespace Lean.Elab.SafeImport

/-- Version of the export format. -/
def formatVersion : Nat := 1

/-! ## Export (runs in the sandbox) -/

structure ExportState where
  nameIdx : Std.HashMap Name Nat := {}
  names : Array Json := #[.null]
  levelIdx : Std.HashMap Level Nat := {}
  levels : Array Json := #[.null]
  exprIdx : Std.HashMap Expr Nat := {}
  exprs : Array Json := #[]
  decls : Array Json := #[]
  visited : NameSet := {}

abbrev ExportM := ReaderT (Std.HashMap Name ConstantInfo) <| StateT ExportState <| Except String

def findLocal? (n : Name) : ExportM (Option ConstantInfo) :=
  return (← read)[n]?

partial def exportName (n : Name) : ExportM Nat := do
  if n.isAnonymous then
    return 0
  if let some i := (← get).nameIdx[n]? then
    return i
  let j ← match n with
    | .str p s => pure <| Json.arr #[toJson (← exportName p), s]
    | .num p k => pure <| Json.arr #[toJson (← exportName p), toJson k]
    | .anonymous => unreachable!
  modifyGet fun s => (s.names.size,
    { s with names := s.names.push j, nameIdx := s.nameIdx.insert n s.names.size })

partial def exportLevel (l : Level) : ExportM Nat := do
  if l.isZero then
    return 0
  if let some i := (← get).levelIdx[l]? then
    return i
  let j ← match l with
    | .succ l => pure <| Json.arr #["succ", toJson (← exportLevel l)]
    | .max a b => pure <| Json.arr #["max", toJson (← exportLevel a), toJson (← exportLevel b)]
    | .imax a b => pure <| Json.arr #["imax", toJson (← exportLevel a), toJson (← exportLevel b)]
    | .param n => pure <| Json.arr #["param", toJson (← exportName n)]
    | .mvar _ => throw "unexpected universe metavariable"
    | .zero => unreachable!
  modifyGet fun s => (s.levels.size,
    { s with levels := s.levels.push j, levelIdx := s.levelIdx.insert l s.levels.size })

def exportBinderInfo : BinderInfo → Json
  | .default => "default"
  | .implicit => "implicit"
  | .strictImplicit => "strictImplicit"
  | .instImplicit => "instImplicit"

/-- Exports an expression. Metadata is dropped as it is irrelevant to the kernel. -/
partial def exportExpr (e : Expr) : ExportM Nat := do
  if let .mdata _ e := e then
    return (← exportExpr e)
  if let some i := (← get).exprIdx[e]? then
    return i
  let j ← match e with
    | .bvar i => pure <| Json.arr #["bvar", toJson i]
    | .sort l => pure <| Json.arr #["sort", toJson (← exportLevel l)]
    | .const n ls =>
      pure <| Json.arr #["const", toJson (← exportName n), toJson (← ls.toArray.mapM exportLevel)]
    | .app f a => pure <| Json.arr #["app", toJson (← exportExpr f), toJson (← exportExpr a)]
    | .lam n t b bi =>
      pure <| Json.arr #["lam", toJson (← exportName n), toJson (← exportExpr t),
        toJson (← exportExpr b), exportBinderInfo bi]
    | .forallE n t b bi =>
      pure <| Json.arr #["pi", toJson (← exportName n), toJson (← exportExpr t),
        toJson (← exportExpr b), exportBinderInfo bi]
    | .letE n t v b nondep =>
      pure <| Json.arr #["let", toJson (← exportName n), toJson (← exportExpr t),
        toJson (← exportExpr v), toJson (← exportExpr b), toJson nondep]
    | .lit (.natVal k) => pure <| Json.arr #["nat", toString k]
    | .lit (.strVal s) => pure <| Json.arr #["str", s]
    | .proj s i e =>
      pure <| Json.arr #["proj", toJson (← exportName s), toJson i, toJson (← exportExpr e)]
    | .fvar _ | .mvar _ => throw "unexpected free variable or metavariable"
    | .mdata .. => unreachable!
  modifyGet fun s => (s.exprs.size,
    { s with exprs := s.exprs.push j, exprIdx := s.exprIdx.insert e s.exprs.size })

def exportConstantVal (v : ConstantVal) : ExportM (List (String × Json)) := do
  return [("name", toJson (← exportName v.name)),
    ("lparams", toJson (← v.levelParams.toArray.mapM exportName)),
    ("type", toJson (← exportExpr v.type))]

def exportHints : ReducibilityHints → Json
  | .opaque => "opaque"
  | .abbrev => "abbrev"
  | .regular h => toJson h.toNat

/--
Exports the local constant `n` after the local constants it depends on. Constructors and recursors
are exported via their inductive types. Unsafe and partial constants are skipped.
-/
partial def exportConst (n : Name) : ExportM Unit := do
  if (← get).visited.contains n then
    return
  let some ci ← findLocal? n
    | return  -- imported
  modify fun s => { s with visited := s.visited.insert n }
  match ci with
  | .ctorInfo v => exportConst v.induct
  | .recInfo v => v.all.forM exportConst
  | .quotInfo _ => throw "unexpected quotient declaration"
  | .inductInfo v =>
    if v.isUnsafe then
      return
    let types ← v.all.mapM fun n => do
      let some (.inductInfo v) ← findLocal? n
        | throw s!"unknown inductive type '{n}'"
      let ctors ← v.ctors.mapM fun c => do
        let some ci ← findLocal? c
          | throw s!"unknown constructor '{c}'"
        pure ci
      pure (v, ctors)
    let block := v.all ++ types.flatMap (·.2.map (·.name))
    modify fun s => { s with visited := block.foldl (·.insert ·) s.visited }
    for (v, ctors) in types do
      for n in v.type.getUsedConstants do exportConst n
      for c in ctors do
        for n in c.type.getUsedConstants do exportConst n
    let types ← types.mapM fun (v, ctors) => do
      return Json.mkObj [("name", toJson (← exportName v.name)),
        ("type", toJson (← exportExpr v.type)),
        ("ctors", toJson (← ctors.toArray.mapM fun c => do
          return Json.mkObj [("name", toJson (← exportName c.name)),
            ("type", toJson (← exportExpr c.type))]))]
    pushDecl <| Json.mkObj [("kind", "induct"),
      ("lparams", toJson (← v.levelParams.toArray.mapM exportName)),
      ("nparams", toJson v.numParams), ("types", toJson types.toArray)]
  | _ =>
    if ci.isUnsafe || ci.isPartial then
      return
    for n in ci.getUsedConstantsAsSet do exportConst n
    let base ← exportConstantVal ci.toConstantVal
    match ci with
    | .axiomInfo _ => pushDecl <| Json.mkObj <| ("kind", "axiom") :: base
    | .defnInfo v =>
      pushDecl <| Json.mkObj <| ("kind", "defn") :: ("value", toJson (← exportExpr v.value)) ::
        ("hints", exportHints v.hints) :: base
    | .thmInfo v =>
      pushDecl <| Json.mkObj <| ("kind", "thm") :: ("value", toJson (← exportExpr v.value)) :: base
    | .opaqueInfo v =>
      pushDecl <| Json.mkObj <| ("kind", "opaque") :: ("value", toJson (← exportExpr v.value)) :: base
    | _ => unreachable!
where
  pushDecl (j : Json) : ExportM Unit :=
    modify fun s => { s with decls := s.decls.push j }

/--
Exports the kernel declarations of the main module of `env`. This includes declarations that the
module itself imported via `safe import`.
-/
public def exportModule (env : Environment) : Except String String := do
  let kenv := env.toKernelEnv
  let locals := kenv.constants.foldStage2 (fun m n ci => m.insert n ci) ({} : Std.HashMap _ _)
  let names := locals.keys.toArray.qsort Name.quickLt
  let go : ExportM (Array Json) := do
    for n in names do exportConst n
    env.header.imports.mapM fun i => return toJson (← exportName i.module)
  let (imports, s) ← go.run locals |>.run {}
  return Json.compress <| Json.mkObj [
    ("version", toJson formatVersion), ("imports", toJson imports), ("names", toJson s.names),
    ("levels", toJson s.levels), ("exprs", toJson s.exprs), ("decls", toJson s.decls)]

/-! ## Import (runs in the trusted process, on untrusted input) -/

structure Tables where
  names : Array Name := #[]
  levels : Array Level := #[]
  exprs : Array Expr := #[]

/-- Maximum universe level depth accepted by `Level.mkData`. -/
def maxLevelDepth : Nat := 16777215

/-- Maximum loose bound variable range accepted by `Expr.mkData`. -/
def maxBVarRange : Nat := 1048575

def getIdx (tbl : Array α) (what : String) (j : Json) : Except String α := do
  let i ← j.getNat?
  let some a := tbl[i]? | throw s!"invalid {what} index {i}"
  return a

def decodeName (names : Array Name) (j : Json) : Except String Name := do
  let #[p, c] ← j.getArr? | throw "invalid name entry"
  let p ← getIdx names "name" p
  match c with
  | .str s => return .str p s
  | .num _ => return .num p (← c.getNat?)
  | _ => throw "invalid name entry"

def decodeLevel (t : Tables) (j : Json) : Except String Level := do
  let args ← j.getArr?
  let some (Json.str kind) := args[0]? | throw "invalid level entry"
  let lvl := getIdx t.levels "level"
  -- `Level.mkData`, which runs on construction, aborts the process on overly deep levels
  let checkDepth (ls : List Level) : Except String Unit := do
    if ls.foldl (fun d l => max d l.data.depth.toNat) 0 + 1 ≥ maxLevelDepth then
      throw "universe level too deep"
  match kind, args.size with
  | "succ", 2 =>
    let l ← lvl args[1]!
    checkDepth [l]
    return mkLevelSucc l
  | "max", 3 =>
    let a ← lvl args[1]!; let b ← lvl args[2]!
    checkDepth [a, b]
    return mkLevelMax a b
  | "imax", 3 =>
    let a ← lvl args[1]!; let b ← lvl args[2]!
    checkDepth [a, b]
    return mkLevelIMax a b
  | "param", 2 => return mkLevelParam (← getIdx t.names "name" args[1]!)
  | _, _ => throw "invalid level entry"

def decodeBinderInfo : Json → Except String BinderInfo
  | .str "default" => return .default
  | .str "implicit" => return .implicit
  | .str "strictImplicit" => return .strictImplicit
  | .str "instImplicit" => return .instImplicit
  | _ => throw "invalid binder info"

def decodeExpr (t : Tables) (j : Json) : Except String Expr := do
  let args ← j.getArr?
  let some (Json.str kind) := args[0]? | throw "invalid expression entry"
  let name := getIdx t.names "name"
  let expr := getIdx t.exprs "expression"
  match kind, args.size with
  | "bvar", 2 =>
    let i ← args[1]!.getNat?
    -- `Expr.mkData` aborts the process on larger indices
    if i + 1 > maxBVarRange then throw "bound variable index too large"
    return .bvar i
  | "sort", 2 => return .sort (← getIdx t.levels "level" args[1]!)
  | "const", 3 =>
    let ls ← (← args[2]!.getArr?).mapM (getIdx t.levels "level")
    return .const (← name args[1]!) ls.toList
  | "app", 3 => return .app (← expr args[1]!) (← expr args[2]!)
  | "lam", 5 =>
    return .lam (← name args[1]!) (← expr args[2]!) (← expr args[3]!) (← decodeBinderInfo args[4]!)
  | "pi", 5 =>
    return .forallE (← name args[1]!) (← expr args[2]!) (← expr args[3]!)
      (← decodeBinderInfo args[4]!)
  | "let", 6 =>
    return .letE (← name args[1]!) (← expr args[2]!) (← expr args[3]!) (← expr args[4]!)
      (← args[5]!.getBool?)
  | "nat", 2 =>
    let s ← args[1]!.getStr?
    let some k := s.toNat? | throw "invalid natural number literal"
    return .lit (.natVal k)
  | "str", 2 => return .lit (.strVal (← args[1]!.getStr?))
  | "proj", 4 => return .proj (← name args[1]!) (← args[2]!.getNat?) (← expr args[3]!)
  | _, _ => throw "invalid expression entry"

def decodeHints : Json → Except String ReducibilityHints
  | .str "opaque" => return .opaque
  | .str "abbrev" => return .abbrev
  | j => do
    let h ← j.getNat?
    if h < UInt32.size then return .regular h.toUInt32 else throw "invalid reducibility hint"

/--
Decodes a declaration. The format cannot express unsafe or partial declarations, nor quotients.
-/
def decodeDecl (t : Tables) (j : Json) : Except String Declaration := do
  let name (k : String) : Except String Name := do getIdx t.names "name" (← j.getObjVal? k)
  let expr (k : String) : Except String Expr := do
    getIdx t.exprs "expression" (← j.getObjVal? k)
  let lparams : Except String (List Name) := do
    (← (← j.getObjVal? "lparams").getArr?).toList.mapM (getIdx t.names "name")
  let constVal : Except String ConstantVal := do
    return { name := (← name "name"), levelParams := (← lparams), type := (← expr "type") }
  match ← j.getObjValAs? String "kind" with
  | "axiom" => return .axiomDecl { toConstantVal := (← constVal), isUnsafe := false }
  | "defn" =>
    let v ← constVal
    let value ← expr "value"
    let hints ← decodeHints (← j.getObjVal? "hints")
    return .defnDecl { toConstantVal := v, value, hints, safety := .safe, all := [v.name] }
  | "thm" =>
    let v ← constVal
    let value ← expr "value"
    return .thmDecl { toConstantVal := v, value, all := [v.name] }
  | "opaque" =>
    let v ← constVal
    let value ← expr "value"
    return .opaqueDecl { toConstantVal := v, value, isUnsafe := false, all := [v.name] }
  | "induct" =>
    let types ← (← (← j.getObjVal? "types").getArr?).mapM fun ty => do
      let ctors ← (← (← ty.getObjVal? "ctors").getArr?).mapM fun c => do
        let name ← getIdx t.names "name" (← c.getObjVal? "name")
        let type ← getIdx t.exprs "expression" (← c.getObjVal? "type")
        return ({ name, type } : Constructor)
      let name ← getIdx t.names "name" (← ty.getObjVal? "name")
      let type ← getIdx t.exprs "expression" (← ty.getObjVal? "type")
      return ({ name, type, ctors := ctors.toList } : InductiveType)
    return .inductDecl (← lparams) (← j.getObjValAs? Nat "nparams") types.toList (isUnsafe := false)
  | k => throw s!"invalid declaration kind '{k}'"

structure ExportData where
  imports : Array Name
  decls : Array Declaration

def decodeExport (s : String) : Except String ExportData := do
  let j ← Json.parse s
  unless (← j.getObjValAs? Nat "version") == formatVersion do
    throw "unsupported export format version"
  let mut t : Tables := { names := #[.anonymous], levels := #[.zero] }
  for e in (← (← j.getObjVal? "names").getArr?)[1...*] do
    t := { t with names := t.names.push (← decodeName t.names e) }
  for e in (← (← j.getObjVal? "levels").getArr?)[1...*] do
    t := { t with levels := t.levels.push (← decodeLevel t e) }
  for e in ← (← j.getObjVal? "exprs").getArr? do
    t := { t with exprs := t.exprs.push (← decodeExpr t e) }
  let imports ← (← (← j.getObjVal? "imports").getArr?).mapM (getIdx t.names "name")
  let decls ← (← (← j.getObjVal? "decls").getArr?).mapM (decodeDecl t)
  return { imports, decls }

/--
Returns whether an equal declaration is already in the environment, which happens if a module is
safe-imported along multiple paths. Throws if a different declaration of the same name exists.
-/
def isPresent (env : Environment) (decl : Declaration) : Except String Bool := do
  let names := decl.getNames
  if names.all (!env.contains ·) then
    return false
  let same : Bool := match decl, decl.getTopLevelNames.head?.bind (env.find? ·) with
    | .axiomDecl v, some (.axiomInfo w) => v.toConstantVal == w.toConstantVal
    | .defnDecl v, some (.defnInfo w) => v.toConstantVal == w.toConstantVal && v.value == w.value
    | .thmDecl v, some (.thmInfo w) => v.toConstantVal == w.toConstantVal
    | .opaqueDecl v, some (.opaqueInfo w) =>
      v.toConstantVal == w.toConstantVal && v.value == w.value
    | .inductDecl lparams nparams types _, _ => types.all fun ty =>
      match env.find? ty.name with
      | some (.inductInfo w) =>
        w.levelParams == lparams && w.numParams == nparams && w.type == ty.type && !w.isUnsafe &&
        w.ctors == ty.ctors.map (·.name) &&
        ty.ctors.all fun c => env.find? c.name |>.any (·.type == c.type)
      | _ => false
    | _, _ => false
  unless same do
    throw s!"'{names.find? (env.contains ·) |>.getD .anonymous}' has already been declared"
  return true

/-- Adds the declarations of a safe-imported module to `env`, type checking all of them. -/
def addDecls (env : Environment) (decls : Array Declaration) (opts : Options) : IO Environment := do
  let mut env := env
  for decl in decls do
    if ← IO.ofExcept (isPresent env decl) then
      continue
    env := decl.getNames.foldl registerNamePrefixes env
    match env.addDeclCore 0 0 decl (cancelTk? := none) with
    | .ok env' => env := env'
    | .error ex => throw <| IO.userError (← (ex.toMessageData opts).toString)
    match decl with
    | .defnDecl _ | .opaqueDecl _ | .axiomDecl _ => env := decl.getNames.foldl addNoncomputable env
    | _ => pure ()
  return env

/-- Locates the source file and package root of `mod` via `LEAN_SRC_PATH` and the current directory. -/
def findSource (mod : Name) : IO (System.FilePath × System.FilePath) := do
  let sp := (← getSrcSearchPath) ++ [← IO.currentDir]
  for root in sp do
    let file := modToFilePath root mod "lean"
    if ← file.pathExists then
      return (root, file)
  throw <| IO.userError s!"cannot find the source of module '{mod}' in the search path \
    entries:\n{"\n".intercalate <| sp.map (·.toString)}"

/-- Elaborates `mod` in the sandbox given by `LEAN_SAFE_SANDBOX` and returns its export. -/
def runSandbox (mod : Name) : IO String := do
  let some sandbox ← IO.getEnv "LEAN_SAFE_SANDBOX"
    | throw <| IO.userError "`safe import` requires the environment variable `LEAN_SAFE_SANDBOX` \
      to be set to a command prefix that runs a command in a sandbox"
  let cmd :: args := sandbox.splitToList Char.isWhitespace |>.filter (· != "")
    | throw <| IO.userError "`LEAN_SAFE_SANDBOX` is empty"
  let (root, file) ← findSource mod
  let child ← IO.Process.spawn {
    cmd, args := args.toArray ++ #[(← IO.appPath).toString, "--safe-export",
      s!"--root={root}", file.toString]
    -- nested safe imports are already inside the sandbox
    env := #[("LEAN_SAFE_SANDBOX", some "env")]
    stdin := .null, stdout := .piped, stderr := .inherit }
  let out ← child.stdout.readToEnd
  let code ← child.wait
  if code != 0 then
    throw <| IO.userError s!"sandboxed elaboration of '{mod}' failed with exit code {code}"
  return out

/--
Processes `safe import mod`: elaborates `mod` in a sandbox and adds its kernel declarations to
`env` after checking them. The regular imports of `mod` must have been imported into `env` already.
-/
public def importSafeModule (env : Environment) (mod : Name) (opts : Options) :
    IO Environment := do
  let data ← match decodeExport (← runSandbox mod) with
    | .ok data => pure data
    | .error e => throw <| IO.userError s!"invalid export of '{mod}': {e}"
  for imp in data.imports do
    if (env.getModuleIdx? imp).isNone then
      throw <| IO.userError s!"safe-imported module '{mod}' imports '{imp}', which is not imported \
        by this module; add `import {imp}` if it is trusted, otherwise `safe import` it in '{mod}'"
  try
    addDecls env data.decls opts
  catch e =>
    throw <| IO.userError s!"failed to safe import '{mod}': {e}"

end Lean.Elab.SafeImport
